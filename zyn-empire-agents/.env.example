# ZYN Empire — environment template (copy to .env and fill in)
# All keys are FREE, no credit card required.

# Groq — primary LLM, free at https://console.groq.com
GROQ_API_KEY=

# Google Gemini — fallback LLM, free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google service account JSON for Sheets access (must have Editor on the master Sheet)
GOOGLE_SA_JSON_PATH=/home/zyn/.config/zyn/service_account.json

# Master Sheet
SHEET_ID=1WHN438mjORT4HnGiXapWv78uomVy6KMhHsl0llxaeQk

# Apps Script proxy URL — for Discord notifications (holds webhooks server-side)
GAS_PROXY_URL=

# Optional: Tavily for web search (free tier 1k req/mo, no card)
TAVILY_API_KEY=

# Optional: Gmail SMTP (free, app password from Google account)
GMAIL_USER=
GMAIL_APP_PASS=
